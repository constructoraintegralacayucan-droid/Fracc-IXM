generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EstatusLote {
  DISPONIBLE
  APARTADO
  VENDIDO
}

enum TipoPago {
  CONTADO
  CREDITO
}

enum RolUsuario {
  ADMIN
  VENDEDOR
}

enum EstatusReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  EXPIRADA
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  DEPOSITO
  TARJETA
  OTRO
}

enum TipoOrdenPago {
  RESERVA
  CUOTA
}

enum EstatusOrdenPago {
  PENDIENTE
  PAGADA
  FALLIDA
  EXPIRADA
}

model Manzana {
  id            String      @id @default(cuid())
  desarrollo    Desarrollo  @relation(fields: [desarrolloId], references: [id])
  desarrolloId  String
  numero        Int
  lotes         Lote[]

  @@unique([desarrolloId, numero])
}

model Lote {
  id                 String        @id @default(cuid())
  desarrollo         Desarrollo    @relation(fields: [desarrolloId], references: [id])
  desarrolloId       String
  manzana            Manzana       @relation(fields: [manzanaId], references: [id])
  manzanaId          String
  numero             Int
  clave              String
  precio             Decimal       @db.Decimal(12, 2)
  areaM2             Float?
  frenteM             Float?
  fondoM              Float?
  estatus            EstatusLote   @default(DISPONIBLE)
  tipoPago           TipoPago?
  anticipo           Decimal       @default(0) @db.Decimal(12, 2)
  saldo              Decimal       @default(0) @db.Decimal(12, 2)
  apartadoMonto      Decimal       @default(0) @db.Decimal(12, 2)
  compradorNombre    String?
  compradorTelefono  String?
  compradorCorreo    String?
  notas              String?
  reservas           Reserva[]

  cliente            Cliente?      @relation(fields: [clienteId], references: [id])
  clienteId          String?
  numPagosTotal      Int?
  montoPagoMensual   Decimal?      @db.Decimal(12, 2)
  fechaInicioPagos   DateTime?
  pagos              Pago[]
  ordenesPago        OrdenPago[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([desarrolloId, clave])
  @@index([manzanaId])
  @@index([desarrolloId])
  @@index([estatus])
  @@index([clienteId])
}

model Cliente {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  nombre       String
  telefono     String?
  lotes        Lote[]
  testimonios  Testimonio[]
  ordenesPago  OrdenPago[]
  createdAt    DateTime     @default(now())
}

model Pago {
  id            String     @id @default(cuid())
  lote          Lote       @relation(fields: [loteId], references: [id])
  loteId        String
  numeroCuota   Int?
  monto         Decimal    @db.Decimal(12, 2)
  fecha         DateTime   @default(now())
  metodo        MetodoPago @default(EFECTIVO)
  notas         String?
  registradoPor String?
  ordenPago     OrdenPago?
  createdAt     DateTime   @default(now())

  @@index([loteId])
}

model Reserva {
  id            String         @id @default(cuid())
  lote          Lote           @relation(fields: [loteId], references: [id])
  loteId        String
  nombre        String
  telefono      String
  correo        String?
  montoReserva  Decimal        @db.Decimal(12, 2)
  planTipoPago  TipoPago       @default(CONTADO)
  plazoMeses    Int?
  inicialMonto  Decimal?       @db.Decimal(12, 2)
  mensajeCliente String?
  estatus       EstatusReserva @default(PENDIENTE)
  expiraEn      DateTime?
  ordenesPago   OrdenPago[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([loteId])
  @@index([estatus])
}

model OrdenPago {
  id             String           @id @default(cuid())
  conektaOrderId String           @unique
  checkoutUrl    String
  tipo           TipoOrdenPago
  monto          Decimal          @db.Decimal(12, 2)
  estatus        EstatusOrdenPago @default(PENDIENTE)

  lote           Lote?            @relation(fields: [loteId], references: [id])
  loteId         String?
  reserva        Reserva?         @relation(fields: [reservaId], references: [id])
  reservaId      String?
  cliente        Cliente?         @relation(fields: [clienteId], references: [id])
  clienteId      String?
  numeroCuota    Int?

  pago           Pago?            @relation(fields: [pagoId], references: [id])
  pagoId         String?          @unique

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([estatus])
  @@index([loteId])
  @@index([clienteId])
  @@index([reservaId])
}

model ImagenGaleria {
  id            String     @id @default(cuid())
  desarrollo    Desarrollo @relation(fields: [desarrolloId], references: [id])
  desarrolloId  String
  dataUrl       String
  orden         Int        @default(0)
  createdAt     DateTime   @default(now())

  @@index([desarrolloId, orden])
}

enum EstatusTestimonio {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Testimonio {
  id            String            @id @default(cuid())
  desarrollo    Desarrollo        @relation(fields: [desarrolloId], references: [id])
  desarrolloId  String
  cliente       Cliente?          @relation(fields: [clienteId], references: [id])
  clienteId     String?
  nombre        String
  mensaje       String
  calificacion  Int               @default(5)
  estatus       EstatusTestimonio @default(PENDIENTE)
  createdAt     DateTime          @default(now())

  @@index([desarrolloId, estatus])
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  nombre       String
  rol          RolUsuario @default(ADMIN)
  createdAt    DateTime   @default(now())
}

model Desarrollo {
  id                String    @id @default(cuid())
  slug              String    @unique
  nombre            String    @default("Fraccionamiento Ixmegallo")
  ubicacion         String    @default("Acayucan, Veracruz, México")
  moneda            String    @default("MXN")
  descripcion       String    @default("")
  imagenPortada     String?
  inicialMinimoPct  Float     @default(20)
  plazosMeses       Int[]     @default([6, 12, 18, 24, 36, 48, 60, 72, 84, 96])
  plazoMaxPublico   Int       @default(24)
  plazoRecomendado  Int       @default(12)
  tasaInteres       Float     @default(0)
  reservaMinima     Decimal   @default(5000) @db.Decimal(12, 2)
  plazoReservaDias  Int       @default(3)
  ofertaActiva      Boolean   @default(false)
  ofertaTitulo      String?
  ofertaFin         DateTime?
  disclaimer          String  @default("")
  terminosCondiciones String  @default("")
  avisoPrivacidad     String  @default("")
  whatsapp            String?
  activo            Boolean   @default(true)
  orden             Int       @default(0)

  manzanas    Manzana[]
  lotes       Lote[]
  imagenes    ImagenGaleria[]
  testimonios Testimonio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo, orden])
}
