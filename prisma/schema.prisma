generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstatusLote {
  DISPONIBLE
  APARTADO
  VENDIDO
}

enum TipoPago {
  CONTADO
  CREDITO
}

enum RolUsuario {
  ADMIN
  VENDEDOR
}

enum EstatusReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  EXPIRADA
}

model Manzana {
  id      String @id @default(cuid())
  numero  Int    @unique
  lotes   Lote[]
}

model Lote {
  id                 String        @id @default(cuid())
  manzana            Manzana       @relation(fields: [manzanaId], references: [id])
  manzanaId          String
  numero             Int
  clave              String        @unique
  precio             Decimal       @db.Decimal(12, 2)
  areaM2             Float?
  frenteM             Float?
  fondoM              Float?
  estatus            EstatusLote   @default(DISPONIBLE)
  tipoPago           TipoPago?
  anticipo           Decimal       @default(0) @db.Decimal(12, 2)
  saldo              Decimal       @default(0) @db.Decimal(12, 2)
  apartadoMonto      Decimal       @default(0) @db.Decimal(12, 2)
  compradorNombre    String?
  compradorTelefono  String?
  compradorCorreo    String?
  notas              String?
  reservas           Reserva[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([manzanaId])
  @@index([estatus])
}

model Reserva {
  id            String         @id @default(cuid())
  lote          Lote           @relation(fields: [loteId], references: [id])
  loteId        String
  nombre        String
  telefono      String
  correo        String?
  montoReserva  Decimal        @db.Decimal(12, 2)
  planTipoPago  TipoPago       @default(CONTADO)
  plazoMeses    Int?
  inicialMonto  Decimal?       @db.Decimal(12, 2)
  mensajeCliente String?
  estatus       EstatusReserva @default(PENDIENTE)
  expiraEn      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([loteId])
  @@index([estatus])
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  nombre       String
  rol          RolUsuario @default(ADMIN)
  createdAt    DateTime   @default(now())
}

model ProyectoConfig {
  id                String   @id @default(cuid())
  nombre            String   @default("Fraccionamiento Ixmegallo")
  ubicacion         String   @default("Acayucan, Veracruz, México")
  moneda            String   @default("MXN")
  descripcion       String   @default("")
  inicialMinimoPct  Float    @default(10)
  plazosMeses       Int[]    @default([6, 12, 18, 24, 36, 48, 60, 72, 84, 96])
  tasaInteres       Float    @default(0)
  reservaMinima     Decimal  @default(5000) @db.Decimal(12, 2)
  plazoReservaDias  Int      @default(3)
  updatedAt         DateTime @updatedAt
}
